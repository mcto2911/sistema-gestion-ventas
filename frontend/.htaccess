<IfModule mod_dir.c>
    DirectoryIndex index.php index.html index.htm
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /gestion-ventas/
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>